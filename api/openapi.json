{
  "components": {
    "headers": {
      "RequestId": {
        "description": "Identifies this request in logs. Send your own to have it echoed back.",
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "Error": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "description": "Stable, machine-readable name of what went wrong.",
                "type": "string"
              },
              "message": {
                "description": "One sentence for a person.",
                "type": "string"
              },
              "request_id": {
                "description": "The X-Request-Id of the failed request.",
                "type": "string"
              }
            },
            "required": [
              "code",
              "message",
              "request_id"
            ],
            "type": "object"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "session": {
        "description": "The session token: the session cookie in the browser, or `Authorization: Bearer <token>` from an app. Requests that change something must also send `X-Requested-With: ortus`.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "The public API of Ortus. The web client and the phone apps use exactly this API.",
    "license": {
      "identifier": "MIT OR Apache-2.0",
      "name": "MIT OR Apache-2.0"
    },
    "title": "Ortus API",
    "version": "v1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/apps": {
      "get": {
        "description": "For anyone signed in.",
        "operationId": "listApps",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "apps": {
                      "description": "The apps that are installed and switched on, in display order.",
                      "items": {
                        "properties": {
                          "group": {
                            "enum": [
                              "communicate",
                              "organise",
                              "create",
                              "organisation"
                            ],
                            "type": "string"
                          },
                          "id": {
                            "description": "Stable id of the app, such as mail or calendar.",
                            "type": "string"
                          },
                          "path": {
                            "description": "Where the app lives in the web client.",
                            "type": "string"
                          }
                        },
                        "required": [
                          "id",
                          "group",
                          "path"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "apps"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Success.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            }
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Any error, in the common error format."
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "List the apps that are installed and switched on.",
        "tags": [
          "core"
        ]
      }
    },
